# Banco local embutido (PostgreSQL real, iniciado pelo script db). Em produção, use a URL do Render e EMBEDDED_DB=false.
DATABASE_URL="postgresql://postgres:readex@localhost:5433/readex"
EMBEDDED_DB=true
EMBEDDED_DB_PORT=5433
# PG_DATA_DIR=C:/caminho/opcional/pgdata

PORT=3333
JWT_SECRET="troque-este-segredo-em-producao"
JWT_EXPIRES_IN=7d
WEB_ORIGIN="http://localhost:5173"

# Modo demonstração: o código de verificação aparece na resposta da API e no terminal
# (não há envio real de e-mail). Em produção, deixe false e configure um provedor.
DEMO_CODES=true
