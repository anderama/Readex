{
  "name": "@readex/api",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "db": "tsx scripts/db-server.ts",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:reset": "tsx scripts/db-setup.ts --reset",
    "seed": "tsx prisma/seed.ts",
    "demo:reset": "tsx prisma/seed.ts --force",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:render": "prisma db push --skip-generate && tsx prisma/seed.ts && node dist/server.js"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/jwt": "^9.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.1.0",
    "zod": "^3.25.76",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "embedded-postgres": "^17.12.0-beta.19",
    "typescript": "^5.9.3"
  }
}
